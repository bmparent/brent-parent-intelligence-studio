# Cloudflare Pages runtime variables. Never commit a populated .dev.vars file.
PUBLIC_SITE_URL=https://eidos-works.com
GA_MEASUREMENT_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Generate independent random secrets, at least 32 characters each.
EIDOS_RATE_SECRET=
EIDOS_ADMIN_TOKEN=
EIDOS_MAINTENANCE_TOKEN=
# Optional model follow-up: published-source answers need no provider key.
EIDOS_AI_ENABLED=false
OPENAI_API_KEY=
EIDOS_ASSISTANT_MODEL=
EIDOS_AI_DAILY_TOKENS=20000
EIDOS_PROACTIVE_ENABLED=false
# First paid product, separate from the older Snapshot experiment.
EIDOS_SHOP_ENABLED=false
STRIPE_SECRET_KEY=
EIDOS_KIT_WEBHOOK_SECRET=
# Local Wrangler only. NEVER set true in a hosted environment.
EIDOS_LOCAL_TEST=false
