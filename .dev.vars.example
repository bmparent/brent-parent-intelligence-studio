# Cloudflare Pages runtime variables. Never commit a populated .dev.vars file.
PUBLIC_SITE_URL=https://eidos-works.com
GA_MEASUREMENT_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Generate independent random secrets, at least 32 characters each.
EIDOS_RATE_SECRET=
EIDOS_ADMIN_TOKEN=
EIDOS_MAINTENANCE_TOKEN=
# Optional model follow-up: published-source answers need no provider key.
EIDOS_AI_ENABLED=false
OPENAI_API_KEY=
# Playground uses a separate server credential and remains disabled by default.
# Hosted Preview stores this only in the Sentinel backend's Vercel environment.
EIDOS_PLAYGROUND_OPENAI_API_KEY=
EIDOS_PLAYGROUND_AI_MODE=
EIDOS_PLAYGROUND_AI_ENABLED=false
# Leave empty until token-count endpoint billing is supported by evidence.
EIDOS_PLAYGROUND_INPUT_COUNT_PRICING=
EIDOS_ASSISTANT_MODEL=
EIDOS_AI_DAILY_TOKENS=20000
EIDOS_PROACTIVE_ENABLED=false
# First paid product, separate from the older Snapshot experiment.
EIDOS_SHOP_ENABLED=false
STRIPE_SECRET_KEY=
EIDOS_KIT_WEBHOOK_SECRET=
# Local Wrangler only. NEVER set true in a hosted environment.
EIDOS_LOCAL_TEST=false
# New platform backend runs on Sentinel Lab. Configure these two values in Pages.
EIDOS_PLATFORM_URL=https://eidos-sentinel-lab.vercel.app
EIDOS_PLATFORM_TOKEN=

# Owner growth reporting only. Set a random secret through Pages secret management.
# Never expose this value in VITE_* or commit real credentials.
EIDOS_GROWTH_OWNER_TOKEN=
# EIDOS_GROWTH_DB is a D1 binding; see docs/growth/phase1-growth-system.md.
