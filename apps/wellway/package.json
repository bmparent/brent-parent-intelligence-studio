{
  "name": "wellway-journey-demo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Wellway member and advisor demonstration, compatible with the Eidos Works gallery.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "node --import tsx --env-file-if-exists=.env server.mjs",
    "test": "node --import tsx --test tests/data.test.ts tests/evidence-ai.test.ts",
    "test:ui": "npm run build && node tests/ui.test.mjs",
    "test:server": "node tests/server.test.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@types/node": "24.13.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "tsx": "^4.23.0",
    "esbuild": "0.27.3",
    "jsdom": "30.0.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
