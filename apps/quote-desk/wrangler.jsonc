{
  "name": "eidos-quote-desk-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "triggers": { "crons": ["17 7 * * *"] },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": {
    "QUOTE_ENVIRONMENT": "test",
    "QUOTE_CHECKOUT_ENABLED": "false",
    "QUOTE_MAX_ACCOUNTS": "5000",
    "QUOTE_MAX_RECORDS": "500",
    "QUOTE_MAX_EMAILS_PER_DAY": "100"
  },
  "d1_databases": [
    { "binding": "QUOTE_DB", "database_name": "eidos-quote-desk-preview", "database_id": "REPLACE_WITH_ISOLATED_PREVIEW_DATABASE_ID", "migrations_dir": "migrations" }
  ]
}
