{
  "name": "brent-parent-intelligence-studio",
  "private": true,
  "version": "1.1.0",
  "description": "Eidos Works website, Insights hub, and Eidos Snapshot product.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/bmparent/brent-parent-intelligence-studio.git"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "content:generate": "node scripts/generate-insights-assets.mjs",
    "validate:insights": "node scripts/validate-insights.mjs",
    "validate:insights:dist": "node scripts/validate-insights.mjs --check-dist --skip-source-fetch",
    "publish:insight-run": "node scripts/publish-insight-run.mjs",
    "verify:production-insight": "node scripts/verify-production-insight.mjs",
    "build": "node scripts/clean-build-output.mjs && npm run content:generate && npm run typecheck && vite build --outDir dist && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir false && node scripts/prerender.mjs",
    "lint": "eslint .",
    "test:snapshot": "node --import tsx scripts/smoke-snapshot.ts",
    "preview": "vite preview --host 0.0.0.0",
    "verify:prerender": "node scripts/verify-prerender.mjs",
    "verify:editorial": "node scripts/verify-editorial.mjs",
    "verify:urls": "node scripts/verify-urls.mjs",
    "publish:check": "npm run publish:insight-run -- --slot=manual",
    "preview:cf": "npm run build && npx wrangler pages dev dist"
  },
  "dependencies": {
    "@babylonjs/core": "^9.10.1",
    "gsap": "^3.14.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wrangler": "^4.98.0"
  }
}
